# ── Public (inlined into the browser bundle; safe to expose) ─────────────────
# `npm run db:start` prints these for local development.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Server only (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# Used by the seed script and Playwright setup only; the app itself relies on RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Without it the AI summary falls back to a rule-based summary.
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-haiku-5-5
AI_SUMMARY_HOURLY_LIMIT=20
DEMO_SIMULATION_ENABLED=true
