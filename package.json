{
  "name": "vitalis",
  "version": "0.1.0",
  "private": true,
  "description": "Vitalis — a clinical insights platform for clinicians (synthetic data only).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:seed",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed/index.ts",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e:ci": "CI=1 playwright test"
  },
  "dependencies": {
    "@ai-sdk/react": "*",
    "@anthropic-ai/sdk": "^1.13.0",
    "@react-pdf/renderer": "^4.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-virtual": "^3.14.28",
    "@visx/axis": "^4.0.0",
    "@visx/curve": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "ai": "^7.0.181",
    "class-variance-authority": "*",
    "clsx": "*",
    "cmdk": "^1.1.1",
    "lucide-react": "*",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "radix-ui": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "*",
    "tailwind-merge": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "*",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@testing-library/user-event": "*",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "*",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "*",
    "supabase": "^3.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "*",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
